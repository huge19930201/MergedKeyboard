<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  1.0.6 决定性实验版：
	  过滤器与「已验证可用」的原版 WXKBToolbar 完全一致（Bundles + Executables，不写 Mode）。
	  只注入微信输入法的键盘扩展，用来确认注入链路是否打通。
	  注入确认后，1.0.7 再把 com.apple.UIKit 等范围加回来。
	-->
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.tencent.wetype.keyboard</string>
		</array>
		<key>Executables</key>
		<array>
			<string>wxkb_plugin</string>
		</array>
	</dict>
</dict>
</plist>
