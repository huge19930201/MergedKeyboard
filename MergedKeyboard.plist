<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  注入范围：
	   1) com.apple.UIKit               所有用 UIKit 的进程（系统键盘主题用）
	   2) com.tencent.wetype.keyboard   ★微信输入法的键盘扩展（原版 WXKBToolbar 就是注入它）
	                                    键盘跑在独立的 appex 进程里，bundle id 跟微信 App 完全不同
	   3) wxkb_plugin                   该扩展的可执行文件名（兜底，Mode=Any）
	-->
	<key>Filter</key>
	<dict>
		<key>Mode</key>
		<string>Any</string>
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
			<string>com.tencent.wetype.keyboard</string>
		</array>
		<key>Executables</key>
		<array>
			<string>wxkb_plugin</string>
		</array>
	</dict>
</dict>
</plist>
